@tool
class_name Slot
extends Marker3D
## Attachment point on a module's hull, generated by Module from a slot letter
## of its interior ASCII. Sits just outside the doorway; local +Z points out
## of the module. Two modules attach by meeting slot to slot, facing each other.

## Gap kept between two attached hulls (each side), wider than the hull
## greebles (ribs stick out ~0.13 m), so neighbours never interpenetrate.
const GAP := 0.15

@export var size_class: int = 1
## Module ids or kinds this slot takes (see ModuleDef.fits()).
@export var accepts: PackedStringArray = ["module"]

var slot_name: StringName
var module: Module
var occupied_by: Module
## Interior position of the doorway cell (module local), for navigation links.
var door_position := Vector3.ZERO


func is_free() -> bool:
	return occupied_by == null


func can_accept(def: ModuleDef) -> bool:
	return is_free() and def != null and def.fits(accepts, size_class)


## World transform a module must have so that its `own_slot` meets this slot.
## Uses the module's rest transform, so building on a module that is still
## playing its arrival animation lands in the right place.
func mate_transform(own_slot: Slot) -> Transform3D:
	var flip := Transform3D(Basis(Vector3.UP, PI), Vector3.ZERO)
	return rest_transform() * flip * own_slot.transform.inverse()


## World transform of this slot with its module at rest.
func rest_transform() -> Transform3D:
	if module == null or not is_inside_tree():
		return global_transform
	return module.rest_transform * module.global_transform.affine_inverse() * global_transform
