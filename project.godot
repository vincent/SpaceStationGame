; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Space Station Tycoon"
config/description="Manage and improve an abandoned space station."
config/version="0.1.0"
run/main_scene="res://src/world/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
GameClock="*res://src/autoload/game_clock.gd"
GameState="*res://src/autoload/game_state.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/exclude_addons=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="walls"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
