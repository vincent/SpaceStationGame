# Godot
.godot/
*.translation
export_credentials.cfg
*.tmp
__pycache__

# Local tooling
.godot-bin/
build/
!build/.gdignore
.env

# Android signing (never commit keystores)
*.keystore
*.jks

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Builds
dist/
tools/paint/.venv/

# Paint pipeline intermediates (rebuilt by tools/paint.sh <id> --skip-ai)
art/paint/*/*/aligned*/
art/paint/*/*/contact_*
art/paint/*/*/paint_*
