[gd_resource type="Resource" script_class="EncounterDef" format=3]

[ext_resource type="Script" path="res://src/core/encounter_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"wreck_lights"
trigger = &"repaired"
condition = "subject == \"wreck_core\""
channel = &"dialog"
title = "Signs of life"
lines = PackedStringArray("Old relays click somewhere deep in the wreck.", "A work lamp flickers on. For the first time in days, you're not alone in the dark.")
outcomes = PackedStringArray("need morale 10", "flag wreck_awake")
