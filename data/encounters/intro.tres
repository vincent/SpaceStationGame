[gd_resource type="Resource" script_class="EncounterDef" format=3]

[ext_resource type="Script" path="res://src/core/encounter_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"intro"
trigger = &"start"
priority = 10
channel = &"dialog"
title = "Adrift"
lines = PackedStringArray("The rescue capsule's beacon died three days ago.", "Through the hatch: the dark hull of an old station. Cold, silent, full of salvage.", "Maybe you can make it a home.")
outcomes = PackedStringArray("flag intro_seen")
